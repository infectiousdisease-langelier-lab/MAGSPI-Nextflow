/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
 MAGSPI -- MAG-based Strain Profiling and Identification
 Nextflow DSL2 port of the MAGSPI SLURM script collection.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // ---- Input / output -----------------------------------------------------
    input                      = null          // samplesheet: sample,fastq_1,fastq_2
    outdir                     = './results'
    publish_dir_mode           = 'copy'
    email                      = null
    multiqc_config             = null

    // ---- Host depletion -----------------------------------------------------
    host_bowtie2_index         = null          // directory containing <prefix>.*.bt2
    host_fasta                 = null          // used to build the index if no index given
    skip_host_depletion        = false

    // ---- fastp --------------------------------------------------------------
    fastp_args                 = '-c --detect_adapter_for_pe -e 20 -l 50 -3'

    // ---- Assembly -----------------------------------------------------------
    spades_args                = ''            // '--meta' is always added
    skip_quast                 = false

    // ---- Binning ------------------------------------------------------------
    metabat2_min_contig        = 1500
    concoct_chunk_size         = 10000
    concoct_overlap            = 0
    dastool_search_engine      = 'diamond'
    dastool_args               = ''
    skip_maxbin2               = false
    skip_concoct               = false

    // ---- MAG quality --------------------------------------------------------
    checkm_db                  = null          // CHECKM_DATA_PATH
    skip_checkm                = false
    checkm_on                  = 'dastool'     // 'dastool' (recommended) | 'metabat2' (legacy script behaviour)
    min_completeness           = 50
    max_contamination          = 10

    // ---- Taxonomy -----------------------------------------------------------
    gtdbtk_db                  = null          // GTDBTK_DATA_PATH (release directory)
    skip_gtdbtk                = false
    gtdbtk_args                = '--skip_ani_screen'
    gtdbtk_pplacer_scratch     = true

    // ---- Dereplication ------------------------------------------------------
    drep_ani                   = 0.97
    drep_args                  = ''
    skip_drep                  = false

    // ---- Strain profiling ---------------------------------------------------
    skip_instrain              = false
    skip_instrain_compare      = false
    bowtie2_mag_args           = '--very-sensitive-local'
    instrain_profile_args      = ''
    instrain_compare_args      = ''
    instrain_breadth_thresh    = 0.5
    instrain_cov_thresh        = 1.0

    // ---- Stage control ------------------------------------------------------
    // read_prep | assembly | binners | binning | mags | all
    //   binners -> run MetaBAT2/MaxBin2/CONCOCT but stop before DAS Tool
    stop_after                 = 'all'

    // ---- Reporting ----------------------------------------------------------
    skip_multiqc               = false

    // ---- Resource ceilings --------------------------------------------------
    max_cpus                   = 64
    max_memory                 = '512.GB'
    max_time                   = '72.h'

    // ---- Misc ---------------------------------------------------------------
    validate_params            = true
    monochrome_logs            = false
    help                       = false
    trace_report_suffix        = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {

    debug {
        cleanup                 = false
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
    }

    conda {
        conda.enabled           = true
        conda.channels          = ['conda-forge', 'bioconda']
        docker.enabled          = false
        singularity.enabled     = false
        apptainer.enabled       = false
    }

    micromamba {
        conda.enabled           = true
        conda.useMicromamba     = true
        conda.channels          = ['conda-forge', 'bioconda']
        docker.enabled          = false
        singularity.enabled     = false
        apptainer.enabled       = false
    }

    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        conda.channels          = ['conda-forge', 'bioconda']
        docker.enabled          = false
        singularity.enabled     = false
        apptainer.enabled       = false
    }

    docker {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g)'
        conda.enabled           = false
        singularity.enabled     = false
        apptainer.enabled       = false
    }

    arm {
        // for Apple silicon / aarch64 hosts: run the x86-64 images under emulation
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        apptainer.enabled       = false
    }

    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
    }

    slurm      { includeConfig 'conf/slurm.config'      }
    test       { includeConfig 'conf/test.config'       }
    test_stub  { includeConfig 'conf/test_stub.config'  }
}

// Containers are x86-64. Set NXF_SINGULARITY_CACHEDIR / NXF_APPTAINER_CACHEDIR
// to a shared path on HPC so images are pulled once.
apptainer.registry   = 'quay.io'
docker.registry      = 'quay.io'
podman.registry      = 'quay.io'
singularity.registry = 'quay.io'

// Capture Nextflow's own reports
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"  }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"    }

manifest {
    name            = 'MAGSPI'
    author          = 'Langelier Lab'
    homePage        = 'https://github.com/infectiousdisease-langelier-lab/MAGSPI'
    description     = 'MAG-based Strain Profiling and Identification from shotgun metagenomic sequencing'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '0.3.0'
}
