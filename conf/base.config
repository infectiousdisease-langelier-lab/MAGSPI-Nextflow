/*
 * Default resource requests.
 * Values mirror the SLURM requests of the original MAGSPI scripts.
 * Everything is capped by params.max_cpus / max_memory / max_time.
 */

process {

    shell          = ['/bin/bash', '-euo', 'pipefail']
    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]

    cpus   = 1
    memory = '6.GB'
    time   = '4.h'

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_single     { cpus = 1;  memory = '6.GB';   time = '4.h'  }
    withLabel: process_low        { cpus = 4;  memory = '16.GB';  time = '4.h'  }
    withLabel: process_medium     { cpus = 16; memory = '64.GB';  time = '12.h' }
    withLabel: process_high       { cpus = 32; memory = '128.GB'; time = '24.h' }
    withLabel: process_high_mem   { cpus = 64; memory = '512.GB'; time = '72.h' }

    // ---- per-process requests (original SLURM values) -----------------------
    withName: FASTP               { cpus = 4;  memory = '16.GB';  time = '2.h'  }
    withName: BOWTIE2_HOST        { cpus = 8;  memory = '32.GB';  time = '4.h'  }
    withName: SAMTOOLS_NONHOST    { cpus = 4;  memory = '16.GB';  time = '4.h'  }
    withName: BBMAP_REPAIR        { cpus = 4;  memory = '16.GB';  time = '4.h'  }
    withName: SEQKIT_STATS        { cpus = 2;  memory = '8.GB';   time = '2.h'  }
    withName: SPADES_META         { cpus = 16; memory = '128.GB'; time = '24.h' }
    withName: QUAST               { cpus = 8;  memory = '32.GB';  time = '4.h'  }
    withName: MAP_TO_ASSEMBLY     { cpus = 16; memory = '64.GB';  time = '24.h' }
    withName: JGI_DEPTH           { cpus = 4;  memory = '32.GB';  time = '8.h'  }
    withName: METABAT2            { cpus = 16; memory = '128.GB'; time = '24.h' }
    withName: MAXBIN2             { cpus = 16; memory = '128.GB'; time = '24.h' }
    withName: CONCOCT             { cpus = 16; memory = '128.GB'; time = '24.h' }
    withName: CONTIG2BIN          { cpus = 1;  memory = '4.GB';   time = '1.h'  }
    withName: DASTOOL             { cpus = 32; memory = '128.GB'; time = '24.h' }
    withName: CHECKM_LINEAGEWF    { cpus = 16; memory = '64.GB';  time = '24.h' }
    withName: GTDBTK_CLASSIFYWF   { cpus = 64; memory = '512.GB'; time = '72.h' }
    withName: DREP_DEREPLICATE    { cpus = 64; memory = '512.GB'; time = '24.h' }
    withName: BOWTIE2_BUILD       { cpus = 8;  memory = '32.GB';  time = '8.h'  }
    withName: MAP_TO_MAGS         { cpus = 32; memory = '128.GB'; time = '48.h' }
    withName: INSTRAIN_PROFILE    { cpus = 32; memory = '256.GB'; time = '48.h' }
    withName: INSTRAIN_COMPARE    { cpus = 32; memory = '256.GB'; time = '48.h' }
    withName: MULTIQC             { cpus = 2;  memory = '16.GB';  time = '4.h'  }

    // metaSPAdes and dRep frequently exhaust memory on deep libraries: step up
    withName: 'SPADES_META|DREP_DEREPLICATE' {
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 247) ? 'retry' : 'finish' }
        memory        = { task.attempt == 1 ? '128.GB' : task.attempt == 2 ? '256.GB' : '500.GB' }
        maxRetries    = 2
    }
}
