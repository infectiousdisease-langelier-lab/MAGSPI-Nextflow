process {
    container = params.container_image
    withName: CHECKM {
        containerOptions = params.checkm_db ? "-B ${params.checkm_db}:${params.checkm_db}:ro" : ''
    }
    withName: GTDBTK {
        containerOptions = params.gtdbtk_db ? "-B ${params.gtdbtk_db}:${params.gtdbtk_db}:ro" : ''
    }
}

apptainer {
    enabled = true
    autoMounts = true
}
