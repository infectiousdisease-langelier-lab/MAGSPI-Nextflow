/*
 * Per-process publishing and tool arguments.
 * Output directories are numbered in workflow order.
 */

process {

    publishDir = [
        path:    { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode:    params.publish_dir_mode,
        saveAs:  { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTP {
        ext.args   = params.fastp_args
        publishDir = [ path: { "${params.outdir}/01_fastp" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: BOWTIE2_BUILD_HOST {
        publishDir = [ path: { "${params.outdir}/02_host_depletion/index" }, mode: params.publish_dir_mode,
                       enabled: true, saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: BOWTIE2_HOST {
        publishDir = [ path: { "${params.outdir}/02_host_depletion" }, mode: params.publish_dir_mode,
                       pattern: '*.log', saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: SAMTOOLS_NONHOST {
        publishDir = [ path: { "${params.outdir}/03_nonhost" }, mode: params.publish_dir_mode,
                       enabled: false ]
    }

    withName: BBMAP_REPAIR {
        publishDir = [ path: { "${params.outdir}/03_nonhost" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: 'SEQKIT_STATS|COMBINE_SEQKIT' {
        publishDir = [ path: { "${params.outdir}/04_read_stats" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: SPADES_META {
        ext.args   = params.spades_args
        publishDir = [ path: { "${params.outdir}/05_metaspades" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: 'QUAST|COMBINE_QUAST' {
        publishDir = [ path: { "${params.outdir}/06_assembly_stats" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: 'MAP_TO_ASSEMBLY' {
        publishDir = [ path: { "${params.outdir}/07_binning/coverage" }, mode: params.publish_dir_mode,
                       pattern: '*.log', saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: JGI_DEPTH {
        publishDir = [ path: { "${params.outdir}/07_binning/coverage" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: METABAT2 {
        ext.args   = { "-m ${params.metabat2_min_contig} --unbinned" }
        publishDir = [ path: { "${params.outdir}/07_binning/metabat2/${meta.id}" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: MAXBIN2 {
        publishDir = [ path: { "${params.outdir}/07_binning/maxbin2/${meta.id}" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: CONCOCT {
        publishDir = [ path: { "${params.outdir}/07_binning/concoct/${meta.id}" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: CONTIG2BIN {
        publishDir = [ path: { "${params.outdir}/07_binning/contig2bin" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: DASTOOL {
        ext.args   = { "--search_engine ${params.dastool_search_engine} --write_bins ${params.dastool_args}" }
        publishDir = [ path: { "${params.outdir}/08_dastool" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: 'CHECKM_LINEAGEWF|COMBINE_CHECKM' {
        publishDir = [ path: { "${params.outdir}/09_checkm" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: 'STANDARDIZE_MAGS|SUMMARIZE_MAGS' {
        publishDir = [ path: { "${params.outdir}/10_mags" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: GTDBTK_CLASSIFYWF {
        ext.args   = params.gtdbtk_args
        publishDir = [ path: { "${params.outdir}/11_gtdbtk" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: DREP_DEREPLICATE {
        ext.args   = { "-comp ${params.min_completeness} -con ${params.max_contamination} -sa ${params.drep_ani} ${params.drep_args}" }
        publishDir = [ path: { "${params.outdir}/12_drep" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: 'RENAME_MAG_CONTIGS|MAG_CATALOGUE|BOWTIE2_BUILD' {
        publishDir = [ path: { "${params.outdir}/13_mag_references" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: MAP_TO_MAGS {
        ext.args   = params.bowtie2_mag_args
        publishDir = [ path: { "${params.outdir}/14_instrain/bam" }, mode: params.publish_dir_mode,
                       pattern: '*.log', saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: INSTRAIN_PROFILE {
        ext.args   = params.instrain_profile_args
        publishDir = [ path: { "${params.outdir}/14_instrain/profiles" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: AGGREGATE_DETECTION {
        publishDir = [ path: { "${params.outdir}/15_mag_detection" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: INSTRAIN_COMPARE {
        ext.args   = params.instrain_compare_args
        publishDir = [ path: { "${params.outdir}/16_instrain_compare" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: MULTIQC {
        publishDir = [ path: { "${params.outdir}/multiqc" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }

    withName: COLLATE_VERSIONS {
        publishDir = [ path: { "${params.outdir}/pipeline_info" }, mode: params.publish_dir_mode ]
    }
}
