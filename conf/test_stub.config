/*
 * Full-DAG smoke test. Every process runs its stub block, so no tools,
 * containers or databases are needed:
 *   nextflow run . -profile test_stub -stub-run --outdir results_stub
 */

params {
    config_profile_name        = 'Stub test profile'
    config_profile_description = 'Exercises every process stub to validate channel wiring'

    input                      = "${projectDir}/assets/samplesheet_stub.csv"
    host_fasta                 = "${projectDir}/tests/fixtures/host_decoy.fasta"
    checkm_db                  = "${projectDir}/tests/fixtures/checkm_db"
    gtdbtk_db                  = "${projectDir}/tests/fixtures/gtdbtk_db"

    max_cpus                   = 2
    max_memory                 = '4.GB'
    max_time                   = '1.h'
}

process {
    resourceLimits = [ cpus: 2, memory: '4.GB', time: '1.h' ]
}
