/*
 * End-to-end test with real tools on a simulated mini-metagenome.
 *
 * Generate the data first (downloads four NCBI references, ~25 MB of reads):
 *   python3 tests/make_test_data.py --outdir tests/data
 * then
 *   nextflow run . -profile test,docker --outdir results_test
 *
 * CheckM and GTDB-Tk are skipped: they need multi-GB reference databases.
 * Add --checkm_db / --gtdbtk_db and drop the skips to exercise them.
 */

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Simulated three-sample mini-metagenome'

    input                      = "${projectDir}/assets/samplesheet_test.csv"
    host_fasta                 = "${projectDir}/tests/data/host_mt.fasta"

    max_cpus                   = 4
    max_memory                 = '10.GB'
    max_time                   = '2.h'

    metabat2_min_contig        = 1500
    concoct_chunk_size         = 5000

    skip_checkm                = true
    skip_gtdbtk                = true
    skip_multiqc               = false

    drep_ani                   = 0.97
    instrain_breadth_thresh    = 0.1
    instrain_cov_thresh        = 0.5
}

process {
    resourceLimits = [ cpus: 4, memory: '10.GB', time: '2.h' ]
    withName: SPADES_META  { cpus = 4; memory = '8.GB'  }
    withName: DREP_DEREPLICATE { cpus = 2; memory = '6.GB' }
}
